{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @kuvend/web start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/propozime/11111111-1111-4111-8111-111111111111"
      ],
      "numberOfRuns": 1,
      "settings": {
        "emulatedFormFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 2 }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.85 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 360000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
